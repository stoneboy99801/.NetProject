<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Orbit — E-commerce Dashboard</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet"
          href="~/css/Dashboard.css"
          asp-append-version="true" />
</head>
<body>
<!-- ===== SIDEBAR ===== -->
<aside class="sidebar">
<div class="brand">
<div>
 <div class="offcanvas__logo">
  <a asp-controller="Index" asp-action="Index">
  <img src="~/imgs/furniture/logo/logo-light.svg" alt="logo not found">
   </a>
  </div>
</div>
</div>
<div class="nav-label">Overview</div>
<a class="nav-item active"><span class="nav-icon">▦</span> Dashboard</a>
<a asp-controller="Admin" asp-action="ProductList" class="nav-item"><span class="nav-icon">📊</span>Products List</a>
<div class="nav-label">Sales</div>
<a class="nav-item"><span class="nav-icon">🧾</span> Orders <span class="nav-badge">18</span></a>
<a asp-action="AddProducts" asp-controller="Admin" class="nav-item"><span class="nav-icon">📦</span>Add Products</a>
<a class="nav-item"><span class="nav-icon">↩</span> Returns</a>
<div class="nav-label">People</div>
        <a asp-controller="Admin" asp-action="Customers" class="nav-item"><span class="nav-icon">👥</span> Customers</a>
<a class="nav-item"><span class="nav-icon">🚚</span> Vendors</a>
<div class="nav-label">System</div>
<a class="nav-item"><span class="nav-icon">💳</span> Payments</a>
<a class="nav-item"><span class="nav-icon">⚙</span> Settings</a>
<div class="sidebar-footer">
<p>Upgrade to Pro for advanced analytics &amp; unlimited products.</p>
<button class="upgrade-btn">Upgrade Plan</button>
</div>
</aside>
    <div class="main">

        <div class="content">
            @RenderBody()
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>