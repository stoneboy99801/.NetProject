@model Template_Integration.Models.Product
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<div class="panel">

    <div class="panel-head">
        <h2>Add New Product</h2>
        <p>Fill all product details below.</p>


    </div>

    @if(ViewBag.Message != null)

    {
        <div class="alert alert-success">
            @ViewBag.Message
        </div>
    }
    <form asp-action="AddProducts" method="post" enctype="multipart/form-data">

        <div class="form-grid">

            <div class="form-group">
                <label>Product Name</label>
                <input asp-for="ProductName" placeholder="Enter Product Name" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Original Price</label>
                <input asp-for="OriginalPrice" type="number" placeholder="0" />
                <span asp-validation-for="OriginalPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Discount Price</label>
                <input asp-for="DiscountedPrice" type="number" placeholder="0" />
                <span asp-validation-for="DiscountedPrice" class="text-danger"></span>
            </div>

            <div class="form-group full">
                <label>Description</label>
                <textarea asp-for="ProductDescription" rows="5" placeholder="Write Product Description"></textarea>
                <span asp-validation-for="ProductDescription" class="text-danger"></span>
            </div>

            <div class="form-group full">
                <label>Product Image</label>

                <input asp-for="ProductImageFile"
                       type="file"
                       accept="image/*"
                       onchange="previewImage(event)" />

                <img id="preview"
                     src="https://placehold.co/250x180?text=Preview"
                     class="preview-img" />
            </div>

        </div>

        <button type="submit" class="save-btn">
            Save Product
        </button>

    </form>

</div>

<script>
    function previewImage(event){

        let reader = new FileReader();

        reader.onload = function(){

            document.getElementById("preview").src = reader.result;

        }

        reader.readAsDataURL(event.target.files[0]);

    }
</script>