@model List<Template_Integration.Models.Register>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<div class="customer-wrapper">
<table class="customer-table">

    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Password</th>
        <th>Role</th>
        <th>Action</th>
    </tr>
</thead>

    <tbody>

        @foreach (var a in Model)
        {
            <tr data-id="@a.Id">
                <td>@a.Id</td>
                <td class="name">@a.Name</td>
                <td class="email">@a.Email</td>
                <td class="pass">@a.Password</td>
                <td class="role">@a.Role</td>
                <td>
                    <button type="button"
                            onclick="editRow(this)"
                            style="background:#198754;color:white;padding:6px 12px;border:none;border-radius:5px;cursor:pointer;">
                        Edit
                    </button>
                        <a asp-controller="Admin"
                           asp-action="Delete"
                           asp-route-id="@a.Id"
                           onclick="return confirm('Are you sure you want to delete this customer?')"
                           style="display:inline-block;background:#dc3545;color:#fff;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600;transition:.3s;margin-left:5px;">
                            Delete
                        </a>
                </td>
            </tr>
        }

    </tbody>

</table>
</div>
<script>

    function editRow(btn)
    {
        let row = btn.closest("tr");
            if (row.querySelector(".name input") != null)
    {
        return;
    }

        let nameCell = row.querySelector(".name");
        let emailCell = row.querySelector(".email");
        let passCell = row.querySelector(".pass");
        let roleCell = row.querySelector(".role");

        let name = nameCell.innerText.trim();
        let email = emailCell.innerText.trim();
         let role = roleCell.innerText.trim();
         let pass = passCell.innerText.trim();
        nameCell.innerHTML =
            `<input type="text" class="form-control" value="${name}">`;

        emailCell.innerHTML =
            `<input type="email" class="form-control" value="${email}">`;
            passCell.innerHTML =
            `<input type="text" class="form-control" value="${pass}">`;
            roleCell.innerHTML =
            `<input type="text" class="form-control" value="${role}">`;

        btn.innerHTML = "Save";
        btn.style.background = "#0d6efd";

        btn.onclick = function ()
        {
            saveRow(this);
        };
    }

    function saveRow(btn)
    {
        let row = btn.closest("tr");

        let id = row.dataset.id;

        let name = row.querySelector(".name input").value;

        let email = row.querySelector(".email input").value;
        let pass = row.querySelector(".pass input").value;
        let role = row.querySelector(".role input").value;
        fetch("/Admin/UpdateCustomer",
        {
            method: "POST",

            headers:
            {
                "Content-Type": "application/json"
            },

            body: JSON.stringify(
            {
                Id: id,
                Name: name,
                Email: email,
                Password: pass,
                Role: role
            })
        })

        .then(response => response.json())

        .then(result =>
        {
            if(result.success)
            {
                row.querySelector(".name").innerHTML = name;

                row.querySelector(".email").innerHTML = email;
                row.querySelector(".pass").innerHTML = pass;
                 row.querySelector(".role").innerHTML = role;
                btn.innerHTML = "Edit";

                btn.style.background = "#198754";

                btn.onclick = function ()
                {
                    editRow(this);
                };

                alert("Customer Updated Successfully");
            }
            else
            {
                alert("Update Failed");
            }
        })

        .catch(error =>
        {
            console.log(error);
            alert("Server Error");
        });

    }

</script>